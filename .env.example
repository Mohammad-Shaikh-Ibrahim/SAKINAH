# Copy this file to .env.local and fill in values for your environment.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL — set automatically by vite.config.js (do not override unless deploying to a custom subdirectory)
# VITE_BASE_URL=/SAKINAH/

# Backend API URL — leave empty while running in localStorage-only mode
VITE_API_URL=

# App metadata
VITE_APP_NAME=SAKINAH
VITE_APP_VERSION=1.0.0
